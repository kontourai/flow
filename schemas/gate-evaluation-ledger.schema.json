{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kontourai.io/schemas/gate-evaluation-ledger.schema.json",
  "title": "Flow Gate Evaluation Ledger",
  "type": "object",
  "required": ["version", "records"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1" },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "ref": { "type": "object", "required": ["runId", "gateId", "evaluationId"], "additionalProperties": false, "properties": { "runId": { "type": "string", "minLength": 1 }, "gateId": { "type": "string", "minLength": 1 }, "evaluationId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" } } },
    "record": { "type": "object", "required": ["version", "ref", "evaluatedAt", "trigger", "definition", "gate", "originalVerdict", "selections"], "additionalProperties": false, "properties": { "version": { "const": "1" }, "ref": { "$ref": "#/$defs/ref" }, "evaluatedAt": { "type": "string", "format": "date-time" }, "trigger": { "enum": ["ordinary", "freshness", "claimed", "paused"] }, "previousRef": { "$ref": "#/$defs/ref" }, "definition": { "type": "object", "required": ["id", "version", "digest"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }, "gate": { "type": "object", "required": ["id", "digest"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1 }, "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }, "originalVerdict": { "enum": ["pass", "block", "route-back", "wait"] }, "selections": { "type": "array", "items": { "type": "object", "required": ["evidenceId"], "additionalProperties": false, "properties": { "expectationId": { "type": "string", "minLength": 1 }, "evidenceId": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "claimIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "authorityWitness": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["claimId", "traceId", "governingEventId"], "additionalProperties": false, "properties": { "claimId": { "type": "string", "minLength": 1 }, "traceId": { "type": "string", "minLength": 1 }, "governingEventId": { "type": "string", "minLength": 1 } } }] } } } }, "exceptionId": { "type": "string", "minLength": 1 }, "routeBack": { "type": "object", "additionalProperties": false, "properties": { "attempt": { "type": "integer", "minimum": 1 }, "maxAttempts": { "type": "integer", "minimum": 1 }, "retryEpoch": { "type": "integer", "minimum": 1 }, "reason": { "type": "string" }, "selectedRoute": { "type": "string" } } } } }
  }
}
