{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kontourai.io/schemas/trust-attachment-reducer.schema.json",
  "title": "Flow Trust Attachment Reducer Result",
  "description": "The separately versioned, side-effect-free trust attachment reducer result. A coordinator supplies all time, identifiers, source metadata, and versioned Hachure/Surface dependencies, then owns writes described by write.artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "evaluation_mode", "evidence", "next_manifest", "next_state", "evaluation", "result", "report", "write"],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "version", "dependency_versions", "dependency_integrities", "hash"],
      "properties": {
        "artifact_id": { "const": "kontourai.flow.trust-attachment-reducer" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "dependency_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hachure", "surface"],
          "properties": { "hachure": { "type": "string" }, "surface": { "type": "string" } }
        },
        "dependency_integrities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hachure", "surface"],
          "properties": {
            "hachure": {
              "type": "object",
              "additionalProperties": false,
              "required": ["validate"],
              "properties": { "validate": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
            },
            "surface": {
              "type": "object",
              "additionalProperties": false,
              "required": ["validate", "buildReport", "checkAuthorityActive"],
              "properties": {
                "validate": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                "buildReport": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                "checkAuthorityActive": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
              }
            }
          }
        },
        "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "evaluation_mode": { "enum": ["evaluate", "attach-only"] },
    "evidence": { "type": "object" },
    "next_manifest": { "type": "object" },
    "next_state": { "type": "object" },
    "evaluation": { "type": ["object", "null"] },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "evaluation", "state"],
      "properties": { "evidence": { "type": "object" }, "evaluation": { "type": ["object", "null"] }, "state": { "type": "object" } }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json", "markdown"],
      "properties": { "json": { "type": "object" }, "markdown": { "type": "string" } }
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "artifacts"],
      "properties": {
        "intent": { "const": "replace" },
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "value"],
            "properties": {
              "path": { "enum": ["evidence/manifest.json", "state.json", "report.json", "report.md"] },
              "value": {}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "evaluation_mode": { "const": "attach-only" } } },
      "then": {
        "properties": {
          "evaluation": { "type": "null" },
          "result": { "properties": { "evaluation": { "type": "null" } } },
          "write": {
            "properties": {
              "artifacts": {
                "minItems": 3,
                "maxItems": 3,
                "allOf": [
                  { "contains": { "properties": { "path": { "const": "evidence/manifest.json" } }, "required": ["path"] }, "minContains": 1, "maxContains": 1 },
                  { "contains": { "properties": { "path": { "const": "report.json" } }, "required": ["path"] }, "minContains": 1, "maxContains": 1 },
                  { "contains": { "properties": { "path": { "const": "report.md" } }, "required": ["path"] }, "minContains": 1, "maxContains": 1 }
                ],
                "not": { "contains": { "properties": { "path": { "const": "state.json" } }, "required": ["path"] } }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "evaluation_mode": { "const": "evaluate" } } },
      "then": {
        "properties": {
          "evaluation": { "type": "object" },
          "result": { "properties": { "evaluation": { "type": "object" } } },
          "write": {
            "properties": {
              "artifacts": {
                "minItems": 4,
                "maxItems": 4,
                "allOf": [
                  { "contains": { "properties": { "path": { "const": "evidence/manifest.json" } }, "required": ["path"] }, "minContains": 1, "maxContains": 1 },
                  { "contains": { "properties": { "path": { "const": "state.json" } }, "required": ["path"] }, "minContains": 1, "maxContains": 1 },
                  { "contains": { "properties": { "path": { "const": "report.json" } }, "required": ["path"] }, "minContains": 1, "maxContains": 1 },
                  { "contains": { "properties": { "path": { "const": "report.md" } }, "required": ["path"] }, "minContains": 1, "maxContains": 1 }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
