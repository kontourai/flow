{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kontourai.io/schemas/gate-evaluation-read-result.schema.json",
  "title": "Flow Gate Evaluation Read Result",
  "oneOf": [
    { "type": "object", "required": ["status"], "additionalProperties": false, "properties": { "status": { "enum": ["missing", "unavailable", "unsupported"] } } },
    { "type": "object", "required": ["status", "evaluation"], "additionalProperties": false, "properties": { "status": { "const": "found" }, "evaluation": { "$ref": "#/$defs/evaluation" } } }
  ],
  "$defs": {
    "evaluation": { "type": "object", "required": ["ref", "evaluatedAt", "originalVerdict", "kind", "trigger", "currentStanding", "currentRun", "selectedEvidence"], "additionalProperties": false, "properties": { "ref": { "$ref": "gate-evaluation-ref.schema.json" }, "evaluatedAt": { "type": "string", "format": "date-time" }, "originalVerdict": { "enum": ["pass", "block", "route-back", "wait"] }, "kind": { "enum": ["initial", "recheck"] }, "trigger": { "enum": ["ordinary", "freshness", "claimed", "paused"] }, "currentStanding": { "enum": ["current", "superseded", "invalidated"] }, "currentRun": { "type": "object", "required": ["status", "currentStep"], "additionalProperties": false, "properties": { "status": { "type": "string", "minLength": 1 }, "currentStep": { "type": ["string", "null"] } } }, "selectedEvidence": { "type": "array", "items": { "type": "object", "required": ["evidenceId", "standing", "freshness", "revocationCodes"], "additionalProperties": false, "properties": { "evidenceId": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "standing": { "enum": ["current", "superseded", "missing"] }, "freshness": { "enum": ["recorded", "stale", "unavailable"] }, "revocationCodes": { "type": "array", "items": { "type": "string", "minLength": 1 } } } } } } }
  }
}
